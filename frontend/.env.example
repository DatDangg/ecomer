# Copy to `.env` and adjust. NEVER commit `.env`.
# Vite chỉ nhúng các biến có prefix `VITE_` vào bundle lúc build.

# Base URL của backend API (bao gồm prefix /api/v1)
# Local dev:
VITE_API_URL=http://localhost:3000/api/v1
# Deploy (Vercel) → URL public của Render:
# VITE_API_URL=https://<ten-service>.onrender.com/api/v1
# ⚠️ VITE_* được nhúng lúc build → đổi giá trị phải redeploy (xem project-ecommerce/10-deployment.md).
